<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Figma specs:
        Fill      : #008CFF
        Radius    : 16dp
        Border    : top=1, right=2, bottom=1, left=1 — #008CFF outer
        Inner shadow: X=0 Y=0 Blur=0 Spread=3 — #FFFFFF 49%  → viền trắng mờ bên trong
        Drop shadow : X=0 Y=3 Blur=0 Spread=0 — #008CFF      → bóng xanh phía dưới
    -->

    <!-- Layer 1: Drop shadow Y=3 phía dưới (#008CFF) -->
    <item
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#008CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 2: Fill chính #008CFF, lệch lên để shadow lộ ra dưới -->
    <item
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#008CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Layer 3: Outer border — 1px top/left/bottom, 2px right (#008CFF lighter) -->
    <!-- Giả lập bằng stroke mỏng màu nhạt hơn để tạo viền -->
    <item
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <corners android:radius="16dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Layer 4: Inner shadow Spread=3 #FFFFFF 49% -->
    <!-- Giả lập bằng stroke trắng mờ bên trong -->
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#7DFFFFFF" />
            <corners android:radius="15dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</layer-list>